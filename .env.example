DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_STT_MODEL=Qwen/Qwen3-ASR-1.7B
SILICONFLOW_STT_FALLBACK_MODELS=FunAudioLLM/SenseVoiceSmall,XingChenAGI/XingChenASR-V3.2
# 临时 5xx/429 时自动重试次数；设为 0 可关闭重试
SILICONFLOW_STT_MAX_RETRIES=3
# 单次语音请求最长等待秒数，防止服务卡住；长录音可调高，范围 10–180
SILICONFLOW_STT_TIMEOUT_SECONDS=90
MODEL_MAX_OUTPUT_TOKENS=512
MODEL_ENABLE_THINKING=false
QUESTION_MODEL=Qwen/Qwen3-8B
